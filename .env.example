# Echte Secrets (keine Non-Secrets hier ablegen!)
# Nicht-geheime Einstellungen (GEMINI_MODEL, EMAIL_TO, EMAIL_FROM, EMAIL_PROVIDER,
# GOOGLE_DRIVE_STAGING_FOLDER_NAME, STREAMLIT_APP_URL) werden direkt in der Web-App
# unter "⚙️ System & Setup" in der Datenbank (SQLite/Turso) gepflegt.

# Google OAuth Web-Client (aus Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AES-256-GCM Schlüssel zum Verschlüsseln der per Web-Login verbundenen Google-Refresh-Tokens
OAUTH_ENCRYPTION_KEY=your_32_byte_base64_encryption_key

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Turso Cloud-Datenbank (leer = lokales SQLite unter data/youtube_bot.db)
TURSO_URL=libsql://your-db-name.aws-eu-west-1.turso.io
TURSO_KEY=your_turso_auth_token

# Benachrichtigungen (Secret)
RESEND_API_KEY=re_your_resend_api_key

# Streamlit Web-App Login-Passwort
APP_PASSWORD=choose_a_strong_password

# Optional: nur nötig, wenn GitHub Actions direkt aus dem Dashboard gestartet werden soll
GITHUB_TOKEN=
