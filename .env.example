# Google OAuth (ein Google-Account für Google Fotos Picker, Google Drive Staging & YouTube)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token

# Google Drive Staging-Ordner (ID optional; wenn leer, wird Ordner per Name gesucht/erstellt)
GOOGLE_DRIVE_STAGING_FOLDER_ID=
GOOGLE_DRIVE_STAGING_FOLDER_NAME=youtube-upload-bot-staging

# Gemini API (Video-Analyse für Titel, Beschreibung & Hashtags)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Turso Cloud-Datenbank (optional; wenn leer, wird lokales SQLite unter data/youtube_bot.db genutzt)
TURSO_URL=
TURSO_KEY=

# Streamlit Web-App Schutz (optional für lokalen Start; für Streamlit Cloud empfohlen)
APP_PASSWORD=

# Benachrichtigungen (Resend HTTPS API oder SMTP-Fallback)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=YouTube Upload Bot <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# GitHub Actions Dispatch (optional für Sofort-Auslösung aus dem Streamlit-Dashboard)
GITHUB_TOKEN=
GITHUB_REPO=hschenke/youtube-upload-bot
GITHUB_BRANCH=main
GITHUB_WORKFLOW_FILE=upload_videos.yaml
STREAMLIT_APP_URL=
