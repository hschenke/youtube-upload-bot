# Beispiel für Streamlit Cloud Secrets (.streamlit/secrets.toml)
GOOGLE_CLIENT_ID = "your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your_google_client_secret"
GOOGLE_REFRESH_TOKEN = "your_google_oauth_refresh_token"
GOOGLE_DRIVE_STAGING_FOLDER_ID = ""
GOOGLE_DRIVE_STAGING_FOLDER_NAME = "youtube-upload-bot-staging"

GEMINI_API_KEY = "your_gemini_api_key"
GEMINI_MODEL = "gemini-3.8-flash"

TURSO_URL = "libsql://your-db-name.aws-eu-west-1.turso.io"
TURSO_KEY = "your_turso_auth_token"

APP_PASSWORD = "choose_a_strong_password"

EMAIL_PROVIDER = "resend"
RESEND_API_KEY = "re_your_api_key"
EMAIL_TO = "you@example.com"
EMAIL_FROM = "YouTube Upload Bot <onboarding@resend.dev>"

GITHUB_TOKEN = "github_pat_..."
GITHUB_REPO = "hschenke/youtube-upload-bot"
GITHUB_BRANCH = "main"
GITHUB_WORKFLOW_FILE = "upload_videos.yaml"
STREAMLIT_APP_URL = "https://your-app.streamlit.app"
