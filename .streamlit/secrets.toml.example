# Beispiel für Streamlit Cloud Secrets (.streamlit/secrets.toml)
# Nur echte Secrets hier hinterlegen – alle übrigen Einstellungen (EMAIL_TO, EMAIL_FROM,
# EMAIL_PROVIDER, GEMINI_MODEL, GOOGLE_DRIVE_STAGING_FOLDER_NAME, STREAMLIT_APP_URL)
# werden in der Web-App unter "⚙️ System & Setup" in der Datenbank gespeichert.

GOOGLE_CLIENT_ID = "your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your_google_client_secret"
OAUTH_ENCRYPTION_KEY = "your_32_byte_base64_encryption_key"

GEMINI_API_KEY = "your_gemini_api_key"

TURSO_URL = "libsql://your-db-name.aws-eu-west-1.turso.io"
TURSO_KEY = "your_turso_auth_token"

RESEND_API_KEY = "re_your_resend_api_key"
APP_PASSWORD = "choose_a_strong_password"

# Optional (nur falls GitHub Actions direkt aus Streamlit heraus angestoßen werden soll)
GITHUB_TOKEN = ""
